# Krishi_Kaar Environment Configuration

# Flask Secret Key
KRISHI_SECRET_KEY=generate_a_secure_hex_key_here

# MongoDB Connection (optional: defaults to local MongoDB or SQLite fallback)
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=krishi_kaar_db

# Arduino Serial Port (optional, e.g. COM3 or /dev/ttyUSB0)
ARDUINO_PORT=COM3
